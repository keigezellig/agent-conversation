# Shared bearer token for creating and inspecting conversations and joining as an agent.
# Generate a strong value with: openssl rand -hex 32
API_TOKEN=replace-with-a-random-secret

AGENT_BRIDGE_URL=http://agent-bridge:8080

# Which API the model endpoint speaks: openai (chat completions) or claude (the Claude API).
LLM_API=openai
# Local OpenAI-compatible model endpoint (the optional Ollama service in docker-compose).
# Leave either one empty to take the chosen API's default.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=
# Most tokens one reply may use. The Claude API requires a limit; chat completions ignore this.
LLM_MAX_TOKENS=1024

# To use the Claude API instead, set LLM_API=claude, empty LLM_BASE_URL and LLM_MODEL above so they
# default to https://api.anthropic.com/v1 and claude-sonnet-5, and set a key here (LLM_API_KEY wins).
ANTHROPIC_API_KEY=

# Read-aloud (--read-aloud / the agent-chat-voice service): any OpenAI-compatible speech endpoint.
# The default is the optional local Kokoro service in docker-compose.
TTS_BASE_URL=http://kokoro:8880/v1
TTS_MODEL=kokoro
TTS_API_KEY=
# Voices given to personas without their own NAME|MOOD|VOICE, in order. Names depend on the engine.
TTS_VOICES=af_heart,am_michael,bf_emma,am_fenrir,af_bella,bm_george
# How quickly the voices speak (0.25-4.0). Above 1.0 is also a little quicker to synthesize.
TTS_SPEED=1.1
# Sample rate of the endpoint's raw (pcm) audio. Kokoro and OpenAI both use 24000.
TTS_SAMPLE_RATE=24000
