# Shared bearer token for creating and inspecting conversations and joining as an agent.
# Generate a strong value with: openssl rand -hex 32
API_TOKEN=replace-with-a-random-secret

# Local OpenAI-compatible model endpoint (the optional Ollama service in docker-compose).
AGENT_BRIDGE_URL=http://agent-bridge:8080
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=
