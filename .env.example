# =============================================================================
# The bridge
# =============================================================================
# Shared bearer token for creating and inspecting conversations and joining as an agent.
# Generate a strong value with: openssl rand -hex 32
API_TOKEN=replace-with-a-random-secret
AGENT_BRIDGE_URL=http://agent-bridge:8080

# =============================================================================
# The model that writes the replies
# =============================================================================
# Two APIs, one block each below: uncomment exactly one and leave the other commented. Leaving
# LLM_BASE_URL or LLM_MODEL empty takes the chosen API's own default. Mind that the flag for
# LLM_MODEL is --model, not --llm-model; the others are --llm-api, --llm-base-url, --llm-api-key.

# -- Provider 1 of 2: any OpenAI-compatible server, the default ---------------
# Chat completions. The endpoint below is the optional Ollama service in docker-compose:
#   docker compose --profile local-model up -d ollama
#   docker compose exec ollama ollama pull llama3.2
# A key is only needed by servers that ask for one. Each reply gets 120 seconds, so a large model on
# CPU can time out on its first turn; keep to a small one without a GPU.
LLM_API=openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=

# -- Provider 2 of 2: the Claude API ------------------------------------------
# Needs no local model, and needs a key: either LLM_API_KEY or ANTHROPIC_API_KEY below, the first
# winning if both are set. Empty base URL and model mean https://api.anthropic.com/v1 and
# claude-sonnet-5; name a current model ID to pick another, such as claude-opus-5.
# LLM_API=claude
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# -- The same whichever provider you picked -----------------------------------
# Most tokens one reply may use. The Claude API requires a limit; chat completions ignore this.
LLM_MAX_TOKENS=1024
# Read by the Claude API block above. Keep it out of the file for a one-off run instead:
#   export ANTHROPIC_API_KEY=sk-ant-...
#   docker compose --profile agents run --rm -e ANTHROPIC_API_KEY agent-chat --llm-api claude ...
ANTHROPIC_API_KEY=

# =============================================================================
# Read-aloud (--read-aloud / the agent-chat-voice service)
# =============================================================================
# Any endpoint speaking OpenAI's POST /v1/audio/speech will do. Three come with docker-compose, one
# block each below: uncomment exactly one and leave the others commented, since a run talks to one
# endpoint. Each flag has the same name as its setting (--tts-speed for TTS_SPEED) and wins over it.

# -- Engine 1 of 3: Kokoro, the default ---------------------------------------
# 54 voices, English/Spanish/French/Italian/Portuguese/Hindi/Japanese/Mandarin. Runs on CPU.
#   docker compose --profile local-tts up -d kokoro
TTS_BASE_URL=http://kokoro:8880/v1
TTS_MODEL=kokoro
TTS_API_KEY=
TTS_FORMAT=pcm

# -- Engine 2 of 3: Speaches --------------------------------------------------
# Kokoro's 54 voices plus ~124 Piper ones, covering ~30 languages, most of Europe. Runs on CPU, and
# each voice is downloaded first (see the README). Give a persona a Piper model as its voice to have
# it read aloud in another language — a voice naming a model is its own single-voice model:
#   --agent "Jeroen|calm, writes Dutch answers|speaches-ai/piper-nl_NL-mls-medium"
# TTS_BASE_URL=http://speaches:8000/v1
# TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX-int8
# TTS_API_KEY=
# TTS_FORMAT=pcm

# -- Engine 3 of 3: edge-tts --------------------------------------------------
# 322 Microsoft voices, ~70 languages, including the ones no local engine has: Serbian, Croatian,
# Bosnian, Albanian. Synthesis happens at Microsoft, so this needs the internet, is not an official
# API, and refuses about one request in three. TTS_FORMAT must be wav: it answers a request for pcm
# with an error, or, without the ffmpeg this project's image adds, with mp3 it labels as pcm.
#   docker compose --profile edge-tts up -d --build edge-tts
# TTS_BASE_URL=http://edge-tts:5050/v1
# TTS_MODEL=tts-1
# TTS_API_KEY=your_api_key_here
# TTS_FORMAT=wav

# -- The same whichever engine you picked -------------------------------------
# Voices handed to personas without their own NAME|MOOD|VOICE, in order. Names come from the engine,
# so these Kokoro names want replacing along with the engine block above.
TTS_VOICES=af_heart,am_michael,bf_emma,am_fenrir,af_bella,bm_george
# How quickly the voices speak (0.25-4.0). Above 1.0 is also a little quicker to synthesize.
TTS_SPEED=1.1
# Sample rate of the endpoint's audio; Kokoro, Speaches and edge-tts all use 24000. A WAV file
# recorded at another rate is refused rather than played at the wrong pitch, and names the rate to set.
TTS_SAMPLE_RATE=24000
# TTS_VOICES=en-US-AvaNeural,en-GB-RyanNeural,en-US-AndrewNeural,en-GB-SoniaNeural
